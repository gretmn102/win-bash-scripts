#!/usr/bin/env bash

if (($# == 0)); then
  echo "Usage: $(basename "$0") FILE|GLOB" >&2
  exit 1
fi

declare -a files

if (($# > 1)); then
  # Например, если шаблон передали без кавычек и shell уже развернул его
  files=("$@")
elif [[ "$1" == *"*"* ]]; then
  # Для шаблона, переданного в кавычках: 'some/path/*.jpg'
  mapfile -t files < <(compgen -G "$1")

  if ((${#files[@]} == 0)); then
    echo "Файлы не найдены: $1" >&2
    exit 1
  fi
else
  files=("$1")
fi

for path in "${files[@]}"; do
  output="${path%.*}.webp"

  if magick "$path" "$output"; then
    # rm -- "$path"
    echo rm "$path"
  else
    echo "Ошибка конвертации: $path" >&2
  fi
done
